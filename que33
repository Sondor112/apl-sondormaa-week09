#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int m[10][10];
    int main_diag = 0;
    int side_diag = 0;
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &m[i][j]);
            if (i == j) {
                main_diag = main_diag + m[i][j];
            }
            if (j == n - 1 - i) {
                side_diag = side_diag + m[i][j];
            }
        }
    }
    
    printf("%d %d\n", main_diag, side_diag);
    
    return 0;
}
