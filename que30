#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[105];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int p, x;
    scanf("%d %d", &p, &x);
    
    for (int i = n - 1; i >= p; i--) {
        a[i + 1] = a[i];
    }
    
    a[p] = x;
    n = n + 1;
    
    for (int i = 0; i < n; i++) {
        printf("%d", a[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    return 0;
}
