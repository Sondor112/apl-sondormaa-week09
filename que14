#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int key;
    scanf("%d", &key);
    
    int index = -1;
    for (int i = n - 1; i >= 0; i--) {
        if (a[i] == key) {
            index = i;
            break;
        }
    }
    
    printf("%d\n", index);
    
    return 0;
}

