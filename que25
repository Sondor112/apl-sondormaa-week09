#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int b[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &b[i]);
    }
    
    long long sum = 0;
    for (int i = 0; i < n; i++) {
        sum = sum + (long long)a[i] * b[i];
    }
    
    printf("%lld\n", sum);
    
    return 0;
}
