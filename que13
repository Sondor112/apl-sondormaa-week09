#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int key;
    scanf("%d", &key);
    
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] == key) {
            count++;
        }
    }
    
    printf("%d\n", count);
    
    return 0;
}
