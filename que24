#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int max = a[0];
    int max_idx = 0;
    int min = a[0];
    int min_idx = 0;
    
    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
            max_idx = i;
        }
        if (a[i] < min) {
            min = a[i];
            min_idx = i;
        }
    }
    
    int temp = a[max_idx];
    a[max_idx] = a[min_idx];
    a[min_idx] = temp;
    
    for (int i = 0; i < n; i++) {
        printf("%d", a[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    return 0;
}
