#include <stdio.h>

int main(void) {
    int n;
   scanf("%d", &n);
    
  int a[100];
    
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int min = a[0];
    int min_index = 0;
    
    for (int i = 1; i < n; i++) {
        if (a[i] < min) {
            min = a[i];
            min_index = i;
        }
    }
    
   printf("%d %d\n", min, min_index);
    
    return 0;
}
