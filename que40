#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int composite[1001] = {0};
    
    for (int p = 2; p * p <= n; p++) {
        if (composite[p] == 0) {
            for (int i = p * p; i <= n; i += p) {
                composite[i] = 1;
            }
        }
    }
    
    int first = 1;
    for (int p = 2; p <= n; p++) {
        if (composite[p] == 0) {
            if (first == 0) {
                printf(" ");
            }
            printf("%d", p);
            first = 0;
        }
    }
    printf("\n");
    
    return 0;
}
