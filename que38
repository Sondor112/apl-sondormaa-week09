#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int max_len = 1;
    int current_len = 1;
    
    for (int i = 0; i < n - 1; i++) {
        if (a[i] < a[i + 1]) {
            current_len = current_len + 1;
        } else {
            if (current_len > max_len) {
                max_len = current_len;
            }
            current_len = 1;
        }
    }
    
    if (current_len > max_len) {
        max_len = current_len;
    }
    
    printf("%d\n", max_len);
    
    return 0;
}
