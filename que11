#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    int sum = 0;
    
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        sum = sum + a[i];
    }
    
    float average = (float)sum / n;
    int count = 0;
    
    for (int i = 0; i < n; i++) {
        if (a[i] > average) {
            count = count + 1;
        }
    }
    
    printf("%d\n", count);
    
    return 0;
}
