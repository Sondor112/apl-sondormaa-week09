#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100]; 
    int pos_count = 0;  
    int neg_count = 0;  
    int zero_count = 0; 
    
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        
        if (a[i] > 0) {
            pos_count++;
        } else if (a[i] < 0) {
            neg_count++;
        } else {
            zero_count++;
        }
    }
    
    printf("%d %d %d\n", pos_count, neg_count, zero_count);
    
    return 0;
}
