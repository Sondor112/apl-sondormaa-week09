#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int m[10][10];
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &m[i][j]);
        }
    }
    
    int check = 1;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (m[i][j] != m[j][i]) {
                check = 0;
            }
        }
    }
    
    if (check == 1) {
        printf("YES\n");
    } else {
        printf("NO\n");
    }
    
    return 0;
}
