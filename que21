#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int k;
    scanf("%d", &k);
    
    int b[100];
    for (int i = 0; i < n; i++) {
        int new_index = (i + k) % n;
        b[new_index] = a[i];
    }
    
    for (int i = 0; i < n; i++) {
        printf("%d", b[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    return 0;
}
