#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int max = -999999;
    int sec_max = -999999;
    
    for (int i = 0; i < n; i++) {
        if (a[i] > max) {
            sec_max = max;
            max = a[i];
        } else if (a[i] > sec_max && a[i] < max) {
            sec_max = a[i];
        }
    }
    
    if (sec_max == -999999) {
        printf("none\n");
    } else {
        printf("%d\n", sec_max);
    }
    
    return 0;
}
