#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int unique_elements[100];
    int count = 0;

    for (int i = 0; i < n; i++) {
        int num;
        scanf("%d", &num);

        int already_exists = 0;
        for (int j = 0; j < count; j++) {
            if (unique_elements[j] == num) {
                already_exists = 1;
                break;
            }
        }

        if (!already_exists) {
            unique_elements[count] = num;
            count++;
        }
    }

    for (int i = 0; i < count; i++) {
        printf("%d", unique_elements[i]);
        if (i < count - 1) {
            printf(" ");
        }
    }
    printf("\n");

    return 0;
}
