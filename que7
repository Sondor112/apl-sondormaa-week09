#include <stdio.h>

int main(void) {
    int n;
    scanf("%d", &n);
     int a[100];
    
      for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
   for (int i = 0; i < n; i += 2) {
        printf("%d", a[i]);
        if (i + 2 < n) {
            printf(" "); 
        }
    }
    printf("\n"); 
    return 0;
}
