#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    
    int a[100];
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    
    int sum = 0;
    for (int i = 0; i < n; i++) {
        sum = sum + a[i];
        printf("%d", sum);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
    return 0;
}
